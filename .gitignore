# Артефакты сборки
/mapsettings
/mapsettings.exe
map-settings

# Локальный конфиг программы (IP/порт, параметры запуска) — не коммитить
mapsettings.json
mapsettings.local.json
*.local.json

# Python-кэш генератора каталога
__pycache__/

# Индекс отладочных номеров интерфейса (генерируется: make dbg-index)
.kilo/dbg-index.txt

# Лог программы (создаётся рядом с бинарником)
mapsettings.log
mapsettings.log.*

# Приватные данные проекта (реестры, индекс отладки, ревью имён и т.п.)
.kilo/

# Кросс-сборки
/dist/
